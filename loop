#!/usr/bin/env bash

set -u

usage() {
  cat <<'EOF'
Usage: loop --agent <codex|claude|agy> [--standard|--small|--large|--plan]
            [--implement-task|--complete-task]
            [--model <model>] [--effort <effort>]
            [--prompt-suffix <text>]

Poll Taskwarrior for pending work and launch the selected coding agent.

One worker drains exactly one routing queue, and the queue flags mirror the
claim predicates in dl-claim.sh so this poll can never count a task the agent
cannot claim:
  --standard  untagged tasks (the default; neither +SMALL, +LARGE, nor +PLAN)
  --small     trivial work tagged +SMALL and not escalated to +LARGE
  --large     work escalated to +LARGE, for a larger-model worker
  --plan      +PLAN decomposition tasks, drained via dev-decompose-task

Use --implement-task or --complete-task to run only that lifecycle stage.
Use --model and --effort to override the selected agent's defaults.
Use --prompt-suffix to append extra instructions to the generated prompt.
EOF
}

agent=""
standard_only=false
small_only=false
large_only=false
plan_only=false
implement_only=false
complete_only=false
model=""
effort=""
prompt_suffix=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent)
      if [ "$#" -lt 2 ]; then
        printf 'loop: --agent requires a value\n' >&2
        usage >&2
        exit 2
      fi
      agent="$2"
      shift 2
      ;;
    --standard)
      standard_only=true
      shift
      ;;
    --small)
      small_only=true
      shift
      ;;
    --large)
      large_only=true
      shift
      ;;
    --plan)
      plan_only=true
      shift
      ;;
    --implement-task)
      implement_only=true
      shift
      ;;
    --complete-task)
      complete_only=true
      shift
      ;;
    --model|--effort|--prompt-suffix)
      option="$1"
      if [ "$#" -lt 2 ] || [ -z "$2" ] || [[ "$2" == --* ]]; then
        printf 'loop: %s requires a value\n' "$option" >&2
        usage >&2
        exit 2
      fi
      case "$option" in
        --model) model="$2" ;;
        --effort) effort="$2" ;;
        --prompt-suffix) prompt_suffix="$2" ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'loop: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

routes_selected=0
for selected in "$standard_only" "$small_only" "$large_only" "$plan_only"; do
  "$selected" && routes_selected=$((routes_selected + 1))
done

if [ "$routes_selected" -gt 1 ]; then
  printf 'loop: --standard, --small, --large, and --plan are mutually exclusive\n' >&2
  usage >&2
  exit 2
fi

if "$implement_only" && "$complete_only"; then
  printf 'loop: --implement-task and --complete-task are mutually exclusive\n' >&2
  usage >&2
  exit 2
fi

if "$plan_only" && { "$implement_only" || "$complete_only"; }; then
  printf 'loop: --plan is its own lifecycle stage and cannot be combined with --implement-task or --complete-task\n' >&2
  usage >&2
  exit 2
fi

case "$agent" in
  codex|claude|agy) ;;
  "")
    printf 'loop: --agent is required\n' >&2
    usage >&2
    exit 2
    ;;
  *)
    printf 'loop: unsupported agent: %s\n' "$agent" >&2
    usage >&2
    exit 2
    ;;
esac

# Each loop process is one worker and needs its own claim identity. Workers that
# share a DEV_LOOP_OWNER are indistinguishable to dl-claim.sh, which reads a
# matching owner as its own prior claim and walks into live work. An explicit
# DEV_LOOP_OWNER from the environment still wins.
if [ -z "${DEV_LOOP_OWNER:-}" ]; then
  worker_suffix="$(od -An -N4 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
  [ -n "$worker_suffix" ] || worker_suffix="$$"
  worker_host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo host)"
  DEV_LOOP_OWNER="${USER:-$(id -un 2>/dev/null || echo user)}@${worker_host}/worker-${worker_suffix}"
fi
export DEV_LOOP_OWNER
printf 'loop: worker owner %s\n' "$DEV_LOOP_OWNER"

# One worker, one queue. Each filter is the Taskwarrior twin of a dl-claim.sh
# identity branch, so a counted task is always a claimable task. Counting more
# broadly than the claim predicate spins the poll loop: the count stays positive,
# every launched agent claims nothing, and the loop relaunches every few seconds.
if "$small_only"; then
  route=small
  task_filter=(status:pending +SMALL -LARGE -PLAN)
  task_scope="pending +SMALL tasks"
  agent_scope="Only discover and process pending tasks tagged +SMALL and not escalated to +LARGE; leave every other task untouched."
elif "$large_only"; then
  route=large
  task_filter=(status:pending +LARGE -PLAN)
  task_scope="pending +LARGE escalated tasks"
  agent_scope="Only discover and process pending tasks tagged +LARGE; leave every other task untouched."
elif "$plan_only"; then
  route=plan
  task_filter=(status:pending +PLAN)
  task_scope="pending +PLAN decomposition tasks"
  agent_scope="Only discover and process pending tasks tagged +PLAN; leave every other task untouched."
else
  route=standard
  task_filter=(status:pending -SMALL -LARGE -PLAN)
  task_scope="pending standard-queue tasks"
  agent_scope="Only discover and process pending tasks tagged none of +SMALL, +LARGE, or +PLAN; leave every other task untouched."
fi

# The routing tags alone. Each stage below counts within this queue using the
# readiness and ownership predicates that stage's agent actually claims on.
queue_filter=("${task_filter[@]}")

# The queue is bound to the claim itself, not just described in the prompt:
# dl-claim.sh reads DEV_LOOP_ROUTE as its default routing flag, so an agent that
# misreads the prose still cannot claim out of its queue.
export DEV_LOOP_ROUTE="$route"
printf 'loop: worker route %s\n' "$DEV_LOOP_ROUTE"

# The board is how one worker's blocker reaches the next worker: task
# annotations are per-task and invisible across the queue. An inherited
# DEV_BOARD_ROOT wins; otherwise default it so the path is never dead.
if [ -z "${DEV_BOARD_ROOT:-}" ]; then
  DEV_BOARD_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/dev-board"
fi
export DEV_BOARD_ROOT
printf 'loop: board root %s\n' "$DEV_BOARD_ROOT"

if "$plan_only"; then
  task_scope="claimable ${task_scope}"
  prompt="Use the dev-decompose-task skill. Decompose one existing eligible task from the ${task_scope} for this repository into its finer-grained follow-up tasks only. Inspect matching pending Taskwarrior tasks first and use the selected task's existing goal and loop-id annotations; do not derive a new goal from this prompt. ${agent_scope} Do not implement, review, or merge any work the plan describes. Exit if no matching claimable task exists."
elif "$implement_only"; then
  task_scope="claimable ${task_scope}"
  prompt="Use the dev-implement-task skill. Implement one existing eligible task from the ${task_scope} for this repository through local review-branch creation only. Inspect matching pending Taskwarrior tasks first and use the selected task's existing goal and loop-id annotations; do not derive a new goal from this prompt. ${agent_scope} Do not review, merge, or complete the task. Exit if no matching claimable task exists."
elif "$complete_only"; then
  task_scope="review-ready ${task_scope}"
  prompt="Use the dev-complete-task skill. Complete one existing implemented task from the ${task_scope} for this repository through review and final disposition only. Inspect matching pending Taskwarrior tasks first and use the selected task's existing goal and loop-id annotations, including its branch annotation; do not derive a new goal from this prompt. ${agent_scope} Do not claim or implement unrelated pending work. Exit if no matching review-ready task exists."
else
  prompt="Use the dev-loop skill. Drain the existing ${task_scope} for this repository. Inspect matching pending Taskwarrior tasks first and use each task's existing goal and loop-id annotations; do not derive a new goal from this prompt. Process each existing goal and loop separately until no matching task remains. ${agent_scope} Exit if no matching pending task exists."
fi

# An escalated task already owns a worktree and branch from the worker that gave
# up on it, and its return path is durable state, not a resume tag.
if "$large_only" && ! "$complete_only"; then
  prompt="${prompt} The task is an escalation: resume its recorded worktree= and branch= annotations instead of creating new ones, read its escalation: and attempt: annotations before editing, and on success record an escalation-result: annotation, remove the +LARGE tag, release the claim, and sync so the task returns to the queue it came from."
fi

if [ -n "$prompt_suffix" ]; then
  prompt="${prompt} ${prompt_suffix}"
fi

# numeric_count <label> <value> — echo <value> if it is a count, else complain
# and echo 0. A non-numeric count would otherwise break the arithmetic below and
# leave the poll comparing an empty string every 30 seconds.
numeric_count() {
  if [[ "$2" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$2"
  else
    printf 'loop: could not count %s; treating as none\n' "$1" >&2
    printf '0\n'
  fi
}

# Claimable: what dl-claim.sh auto-pick will actually take — READY, not already
# started, and unassigned. Dropping the ownership half of that predicate is what
# lets a task another worker is mid-way through keep the count positive.
count_claimable() {
  local n
  n="$(task rc.verbose=nothing +READY -ACTIVE "${queue_filter[@]}" export \
    | jq '[ .[] | select((.assignee // "") == "") ] | length' 2>/dev/null)" || n=""
  numeric_count "claimable ${task_scope}" "$n"
}

# Review-ready: started work that reached a review branch and a summary, which
# is what dev-complete-task picks up regardless of which worker implemented it.
count_completable() {
  local n
  n="$(task rc.verbose=nothing +ACTIVE "${queue_filter[@]}" export | jq '
    [ .[]
      | select(any(.annotations[]?; .description | startswith("branch=")))
      | select(any(.annotations[]?; .description | startswith("summary: ")))
    ] | length
  ' 2>/dev/null)" || n=""
  numeric_count "review-ready ${task_scope}" "$n"
}

eligible_count() {
  if "$complete_only"; then
    count_completable
  elif "$implement_only" || "$plan_only"; then
    count_claimable
  else
    # The dev-loop agent drains both stages, so either kind of task is work for
    # it. Counting every pending task instead would include tasks that are live
    # in another worker's hands: unclaimable, uncompletable, and permanently
    # positive.
    printf '%s\n' "$(( $(count_claimable) + $(count_completable) ))"
  fi
}

run_agent() {
  local agent_args=()

  if [ -n "$model" ]; then
    agent_args+=(--model "$model")
  fi

  case "$agent" in
    codex)
      if [ -n "$effort" ]; then
        agent_args+=(--config "model_reasoning_effort=$effort")
      fi
      bash -c 'export AGENT_PID=$$; exec "$@"' check-agent \
        codex --yolo "${agent_args[@]}" "$prompt"
      ;;
    claude)
      if [ -n "$effort" ]; then
        agent_args+=(--effort "$effort")
      fi
      bash -c 'export AGENT_PID=$$; exec "$@"' check-agent \
        claude --dangerously-skip-permissions "${agent_args[@]}" "$prompt"
      ;;
    agy)
      if [ -n "$effort" ]; then
        agent_args+=(--effort "$effort")
      fi
      bash -c 'export AGENT_PID=$$; exec "$@"' check-agent \
        agy --dangerously-skip-permissions "${agent_args[@]}" \
          --prompt-interactive "$prompt"
      ;;
  esac
}

while true; do
  pending_count="$(eligible_count)"

  if [ "$pending_count" -eq 0 ]; then
    printf 'No %s. Checking again in 30 seconds...\n' "$task_scope"
    sleep 30
    continue
  fi

  run_agent
  printf 'Restarting in 30 seconds...\n'
  if [ -t 1 ]; then
    reset
  fi
  sleep 30
done
